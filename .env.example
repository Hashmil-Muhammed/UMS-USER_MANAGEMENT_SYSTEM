# ==========================================
# User Management System — Environment Variables Template
# Copy this file to .env.local and fill in your Supabase credentials
# ==========================================

# Supabase Project URL & Anon/Publishable Key (Required for client & server auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Secret Key (Server-only administrative access)
# NEVER expose this key to client bundles or commit it to version control!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Local/Production Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
